# URL of the Modrinth modpack page to monitor.
MODRINTH_URL=https://modrinth.com/modpack/winterlands

# Where downloaded files are stored inside the container/host.
DOWNLOAD_DIR=./downloads

# Percentage of browser visits that attempt a download (0–100).
# 100 preserves download-on-every-visit behavior; e.g. 30 leaves ~70% as visits only.
DOWNLOAD_PERCENTAGE=100

# Randomized sleep bounds between runs (minutes).
MIN_DELAY_MINUTES=180
MAX_DELAY_MINUTES=240
# Alternative hour-based controls (if you prefer hours instead of minutes).
# MIN_DELAY_HOURS=3
# MAX_DELAY_HOURS=4

# Set to "true" to run a single cycle and exit (useful for testing).
ONE_SHOT=false

# Path where Playwright should look for installed browsers.
PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers

# ---------------------------------------------------------------------------
# Egress routing
# ---------------------------------------------------------------------------
# direct: no VPN, no proxies (local development).
# vpn:    every run goes through Gluetun.
# proxy:  every run goes through a validated public proxy.
# mixed:  split runs between VPN and proxies; see EGRESS_VPN_SHARE.
EGRESS_MODE=direct

# Percentage of mixed-mode runs that use the VPN; the rest use a public proxy.
EGRESS_VPN_SHARE=50

# Relative weights per country bucket. Equal weights = one third each.
# Accepts ISO 3166-1 alpha-2 codes plus the "other" bucket, e.g. "US=2,DE=1,other=1".
EGRESS_COUNTRY_WEIGHTS=US=1,DE=1,other=1

# Optional explicit country list for the "other" bucket. Leave empty to use the
# built-in list of common VPN server countries (always excluding preferred ones).
EGRESS_OTHER_COUNTRIES=

# Total attempts per run. Each retry picks a new proxy or VPN country.
EGRESS_MAX_RETRIES=3
EGRESS_RETRY_DELAY_SECONDS=10

# What to do when no public proxy is healthy: vpn, direct or none.
EGRESS_PROXY_FALLBACK=vpn

# Verify that the actual exit country matches the requested bucket before
# starting the browser (VPN routes only; proxies are checked during selection).
EGRESS_VERIFY_COUNTRY=true

# Timeout for the pre-flight request through the chosen route.
EGRESS_PROBE_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# VPN route (Gluetun)
# ---------------------------------------------------------------------------
# Gluetun control server (used to rotate country/region/host per run).
GLUETUN_CONTROL_URL=http://localhost:8000
GLUETUN_CONTROL_USER=
GLUETUN_CONTROL_PASSWORD=
# Optional city/region/hostname constraints inside the selected country.
GLUETUN_CITY_POOL=
GLUETUN_REGION_POOL=
GLUETUN_HOSTNAME_POOL=
# Gluetun's built-in HTTP proxy. Required when the monitor is not sharing the
# VPN network namespace (the docker-compose setup uses http://vpn:8888).
VPN_PROXY_URL=
# How long to wait for the tunnel and for the exit country to match.
VPN_CONNECT_TIMEOUT_SECONDS=120
VPN_RESTART_TIMEOUT_SECONDS=30
VPN_STATUS_POLL_SECONDS=3

# Gluetun VPN settings (required when running via docker-compose with VPN).
# See https://github.com/qdm12/gluetun-wiki for provider-specific options.
VPN_SERVICE_PROVIDER=
OPENVPN_USER=
OPENVPN_PASSWORD=

# ---------------------------------------------------------------------------
# Public proxy route
# ---------------------------------------------------------------------------
# Auto-updating feeds: proxifly (countries included), monosans, thespeedx,
# clarketm, hookzof, or any full raw-text URL.
PROXY_SOURCES=proxifly,monosans
# Protocols to keep. https proxies require a certificate Chromium accepts, so
# they are opt-in; most free "https" proxies are self-signed and rejected by the
# browser (and by the health check). IPv6 proxies work when a feed publishes them.
PROXY_PROTOCOLS=http,socks5
# Verify the proxy's own TLS certificate during health checks. Disabling this
# lets Chromium fail later with ERR_PROXY_CERTIFICATE_INVALID.
PROXY_VERIFY_TLS=true
PROXY_REFRESH_MINUTES=30
# Candidate checks per batch; one healthy proxy stops the search.
PROXY_MAX_CANDIDATES=6
PROXY_MAX_POOL_SIZE=5000
PROXY_CHECK_TIMEOUT_MS=6000
PROXY_COOLDOWN_MINUTES=10
PROXY_CHECK_URL=https://api.ipify.org/
PROXY_CACHE_FILE=./data/proxies.json

# IP -> country resolution used to verify proxy exit countries.
GEO_LOOKUP_URL=https://ipwho.is/
GEO_LOOKUP_TIMEOUT_MS=5000
GEO_CACHE_FILE=./data/geo.json

# Per-request audit trail (JSONL, also mirrored to stdout).
EGRESS_LOG_FILE=./logs/egress.jsonl
